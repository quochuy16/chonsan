// ChonSan — schema. Enum lưu dạng String (SQLite); giá trị hợp lệ ở src/lib/domain/constants.ts
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String // "" = tài khoản chỉ đăng nhập bằng Google
  googleId     String?  @unique
  name         String
  phone        String
  role         String   @default("USER") // USER | ADMIN
  province     String?
  district     String?
  skillLevel   String?
  position     String?
  banned       Boolean  @default(false)
  createdAt    DateTime @default(now())

  venues         Venue[]
  staffOf        VenueStaff[]
  bookings       Booking[]
  reviews        Review[]
  notifications   Notification[]
  matchPosts      MatchPost[]
  matchRequests   MatchRequest[]
  ratingsGiven    MatchRating[]   @relation("ratingFrom")
  ratingsReceived MatchRating[]   @relation("ratingTo")
  playerPosts     PlayerPost[]
  playerRequests  PlayerRequest[]
  reports         Report[]
}

model Venue {
  id               String   @id @default(cuid())
  slug             String   @unique
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id])
  name             String
  address          String
  province         String
  district         String
  lat              Float
  lng              Float
  description      String   @default("")
  imageUrl         String?
  phone            String
  openMin          Int      @default(300) // 05:00
  closeMin         Int      @default(1380) // 23:00
  amenities        String   @default("") // CSV: PARKING,WATER,...
  bankBin          String?
  bankAccount      String?
  bankAccountName  String?
  status           String   @default("PENDING") // PENDING | APPROVED | REJECTED
  verified         Boolean  @default(false)
  plan             String   @default("FREE") // FREE | PRO
  autoConfirm      Boolean  @default(false)
  depositType      String   @default("NONE") // NONE | FIXED | PERCENT
  depositValue     Int      @default(0)
  cancelHours      Int      @default(12)
  /// Đơn online chờ xác nhận quá số phút này thì tự hủy để nhả giờ (0 = không tự hủy)
  pendingExpireMin Int      @default(120)
  createdAt        DateTime @default(now())

  pitches    Pitch[]
  priceRules PriceRule[]
  holidays   VenueHoliday[]
  deals      Deal[]
  staff      VenueStaff[]
  reviews    Review[]
}

model VenueStaff {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId])
}

model Pitch {
  id        String  @id @default(cuid())
  venueId   String
  venue     Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String
  sport     String  @default("FOOTBALL")
  size      String  @default("5") // 5 | 7 | 11 (bóng đá)
  surface   String  @default("ARTIFICIAL")
  covered   Boolean @default(false)
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  bookings   Booking[]
  priceRules PriceRule[]
  parentOf   PitchLink[] @relation("parent")
  childOf    PitchLink[] @relation("child")
}

// Sân ghép: parent (vd sân 7) chiếm chỗ của child (các sân 5)
model PitchLink {
  id       String @id @default(cuid())
  parentId String
  parent   Pitch  @relation("parent", fields: [parentId], references: [id], onDelete: Cascade)
  childId  String
  child    Pitch  @relation("child", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
}

model PriceRule {
  id           String  @id @default(cuid())
  venueId      String
  venue        Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  pitchId      String?
  pitch        Pitch?  @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  daysOfWeek   String // CSV 0..6, 0 = Chủ nhật
  startMin     Int
  endMin       Int
  pricePerHour Int
}

model VenueHoliday {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  date    String // YYYY-MM-DD giờ VN
  name    String @default("")
  percent Int    @default(120)

  @@unique([venueId, date])
}

// Giờ trống giảm giá
model Deal {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  start     DateTime
  end       DateTime
  percent   Int
  createdAt DateTime @default(now())
}

model Booking {
  id             String    @id @default(cuid())
  code           String    @unique
  pitchId        String
  pitch          Pitch     @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?     @relation(fields: [userId], references: [id])
  customerName   String
  customerPhone  String
  start          DateTime
  end            DateTime
  totalPrice     Int
  depositAmount  Int       @default(0)
  depositPaid    Boolean   @default(false)
  status         String    @default("PENDING") // PENDING | CONFIRMED | COMPLETED | CANCELLED | NO_SHOW | BLOCKED
  source         String    @default("ONLINE") // ONLINE | MANUAL | BLOCK
  note           String    @default("")
  recurringId    String?
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  cancelledAt    DateTime?

  review Review?

  @@index([pitchId, start])
}

model Review {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @default("")
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Kèo gắn với NGƯỜI đăng (không có quản lý đội). teamName chỉ là tên hiển thị người dùng tự gõ.
model MatchPost {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  teamName  String
  start     DateTime
  venueText String
  pitchSize String   @default("7")
  province  String
  district  String
  level     String   @default("TRUNG_BINH")
  costSplit String   @default("HALF") // HALF | HOST | GUEST
  note      String   @default("")
  status    String   @default("OPEN") // OPEN | MATCHED | CANCELLED | HIDDEN
  createdAt DateTime @default(now())

  requests MatchRequest[]
  ratings  MatchRating[]
}

model MatchRequest {
  id        String    @id @default(cuid())
  postId    String
  post      MatchPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamName  String
  message   String    @default("")
  status    String    @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
}

// Đánh giá uy tín giữa hai người chốt kèo (người đăng ↔ người nhận kèo)
model MatchRating {
  id          String    @id @default(cuid())
  matchPostId String
  matchPost   MatchPost @relation(fields: [matchPostId], references: [id], onDelete: Cascade)
  fromUserId  String
  fromUser    User      @relation("ratingFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User      @relation("ratingTo", fields: [toUserId], references: [id], onDelete: Cascade)
  punctual    Int
  fairplay    Int
  levelMatch  Int
  noShow      Boolean   @default(false)
  comment     String    @default("")
  createdAt   DateTime  @default(now())

  @@unique([matchPostId, fromUserId])
}

model PlayerPost {
  id           String   @id @default(cuid())
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  teamName     String   @default("") // tên đội/nhóm tự gõ, trống = cá nhân
  start        DateTime
  venueText    String
  province     String
  district     String
  needed       Int
  position     String   @default("")
  feePerPerson Int      @default(0)
  level        String   @default("TRUNG_BINH")
  note         String   @default("")
  status       String   @default("OPEN") // OPEN | FULL | CANCELLED | HIDDEN
  createdAt    DateTime @default(now())

  requests PlayerRequest[]
}

model PlayerRequest {
  id        String     @id @default(cuid())
  postId    String
  post      PlayerPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String     @default("")
  status    String     @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt DateTime   @default(now())

  @@unique([postId, userId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id])
  targetType String // VENUE | MATCH_POST | PLAYER_POST | USER
  targetId   String
  reason     String // BETTING | CHEATING | FRAUD | NO_SHOW | OTHER
  detail     String   @default("")
  status     String   @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt  DateTime @default(now())
}
